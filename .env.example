# Teacher LLM for teacher_check / teacher / teacher_test (scripts/teacher_compress.py).
# Copy to `.env` and fill in. `.env` is gitignored; this template is not, so never put a
# real key here. Values already set in the environment win over `.env`.
#
# Without a .env the DATN teacher is used: iCOMM icmodel/icom-model-llm-ic-v3.8-27b at
# http://172.16.9.11:30049/v1 (internal network, no key). A different teacher means a new
# G4 run before distillation (README).
TEACHER_URL=https://token-api.fpt.ai/v1
TEACHER_MODEL=GLM-5.2
TEACHER_WORKERS=16

# One key, or several numbered keys: calls are spread over them, each key with its own
# rate budget. Keys must be distinct; duplicates and `<...>` placeholders are ignored.
# They are only sent to the TEACHER_URL above, never to another endpoint.
TEACHER_API_KEY_1=<key-1>
TEACHER_API_KEY_2=<key-2>
TEACHER_API_KEY_3=<key-3>
TEACHER_API_KEY_4=<key-4>
